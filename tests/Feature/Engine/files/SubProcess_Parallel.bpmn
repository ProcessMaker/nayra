<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_ParallelSubProcess"
                  targetNamespace="http://processmaker.com/nayra/subprocess">
  <bpmn:process id="Process_Parallel" isExecutable="true">
    <bpmn:startEvent id="Start_Parent">
      <bpmn:outgoing>Flow_To_Sub</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_1" name="Parallel Inner">
      <bpmn:incoming>Flow_To_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
      <bpmn:startEvent id="Start_1">
        <bpmn:outgoing>Flow_To_Fork</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="Fork">
        <bpmn:incoming>Flow_To_Fork</bpmn:incoming>
        <bpmn:outgoing>Flow_To_Left</bpmn:outgoing>
        <bpmn:outgoing>Flow_To_Right</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="Left" name="Left">
        <bpmn:incoming>Flow_To_Left</bpmn:incoming>
        <bpmn:outgoing>Flow_Left_Join</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Right" name="Right">
        <bpmn:incoming>Flow_To_Right</bpmn:incoming>
        <bpmn:outgoing>Flow_Right_Join</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="Join">
        <bpmn:incoming>Flow_Left_Join</bpmn:incoming>
        <bpmn:incoming>Flow_Right_Join</bpmn:incoming>
        <bpmn:outgoing>Flow_To_Inner_End</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="End_1">
        <bpmn:incoming>Flow_To_Inner_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_To_Fork" sourceRef="Start_1" targetRef="Fork"/>
      <bpmn:sequenceFlow id="Flow_To_Left" sourceRef="Fork" targetRef="Left"/>
      <bpmn:sequenceFlow id="Flow_To_Right" sourceRef="Fork" targetRef="Right"/>
      <bpmn:sequenceFlow id="Flow_Left_Join" sourceRef="Left" targetRef="Join"/>
      <bpmn:sequenceFlow id="Flow_Right_Join" sourceRef="Right" targetRef="Join"/>
      <bpmn:sequenceFlow id="Flow_To_Inner_End" sourceRef="Join" targetRef="End_1"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Parent">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_Sub" sourceRef="Start_Parent" targetRef="SubProcess_1"/>
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="SubProcess_1" targetRef="End_Parent"/>
  </bpmn:process>
</bpmn:definitions>
